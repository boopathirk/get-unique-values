{
  "name": "get-unique-values",
  "displayName": "Get Unique Values & CSV Viewer",
  "publisher": "boopathi08",
  "description": "Remove duplicate lines, and view huge CSV files fast: pagination, search, unique values per column, filters, column colours.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "unique",
    "duplicate",
    "remove duplicates",
    "clean",
    "format",
    "csv",
    "csv viewer",
    "large csv",
    "tsv"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "get-unique-values.run",
        "title": "Get Unique Values (Remove Duplicates & Empty Lines)"
      },
      {
        "command": "get-unique-values.openCsvViewer",
        "title": "Open in CSV Viewer"
      }
    ],
    "keybindings": [
      {
        "command": "get-unique-values.run",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "get-unique-values.run",
          "group": "modification"
        }
      ],
      "editor/title": [
        {
          "command": "get-unique-values.openCsvViewer",
          "when": "resourceExtname =~ /^\\.(csv|tsv|psv)$/",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "get-unique-values.openCsvViewer",
          "when": "resourceExtname =~ /^\\.(csv|tsv|psv)$/",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "getUniqueValues.csvViewer",
        "displayName": "CSV Viewer",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          },
          {
            "filenamePattern": "*.psv"
          }
        ]
      }
    ],
    "configuration": {
      "title": "CSV Viewer",
      "properties": {
        "getUniqueValues.csv.defaultPageSize": {
          "type": "number",
          "enum": [
            50,
            100,
            250,
            500,
            1000
          ],
          "default": 100,
          "description": "Rows per page in the CSV Viewer."
        },
        "getUniqueValues.csv.columnColors": {
          "type": "string",
          "enum": [
            "header",
            "headerAndCells",
            "off"
          ],
          "default": "headerAndCells",
          "description": "Give every column its own colour: header only, header plus a tinted cell edge, or off."
        },
        "getUniqueValues.csv.longText": {
          "type": "string",
          "enum": [
            "truncate",
            "wrap",
            "full"
          ],
          "default": "truncate",
          "description": "How long cell values are shown: one truncated line, up to 3 wrapped lines, or in full."
        },
        "getUniqueValues.csv.defaultColumnWidth": {
          "type": "number",
          "default": 300,
          "minimum": 80,
          "description": "Default column width in pixels."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "build": "node esbuild.mjs",
    "compile": "npm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p ./ --noEmit && tsc -p src/viewer --noEmit",
    "lint": "eslint src",
    "test:unit": "node -e \"require('fs').rmSync('out-test',{recursive:true,force:true})\" && node esbuild.mjs && tsc -p tsconfig.test.json && mocha --ui tdd \"out-test/test/unit/**/*.test.js\"",
    "test:integration": "node -e \"require('fs').rmSync('out-test',{recursive:true,force:true})\" && node esbuild.mjs && tsc -p tsconfig.test.json && vscode-test",
    "pretest": "npm run typecheck && npm run lint",
    "test": "npm run test:unit && npm run test:integration",
    "perf": "tsc -p tsconfig.test.json && node --expose-gc scripts/perf.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.25.1",
    "mocha": "^12.0.3",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/boopathirk/get-unique-values.git"
  },
  "bugs": {
    "url": "https://github.com/boopathirk/get-unique-values/issues"
  },
  "homepage": "https://github.com/boopathirk/get-unique-values"
}
