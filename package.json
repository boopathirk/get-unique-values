{
  "name": "get-unique-values",
  "displayName": "Data Toolkit",
  "publisher": "boopathi08",
  "description": "Developer data tools: a fast viewer for huge CSV and Excel (.xlsx) files (pagination, search, unique values, filters, column colours, export to many formats) and duplicate-line removal. More tools coming.",
  "version": "0.2.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "unique",
    "duplicate",
    "remove duplicates",
    "clean",
    "format",
    "csv",
    "csv viewer",
    "large csv",
    "tsv",
    "excel",
    "xlsx",
    "xlsm"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "get-unique-values.run",
        "title": "Get Unique Values (Remove Duplicates & Empty Lines)"
      },
      {
        "command": "get-unique-values.openCsvViewer",
        "title": "Open in CSV Viewer"
      },
      {
        "command": "get-unique-values.csv.hideSelectedColumn",
        "title": "CSV Viewer: Hide Selected Column"
      },
      {
        "command": "get-unique-values.csv.showAllColumns",
        "title": "CSV Viewer: Show All Columns"
      },
      {
        "command": "get-unique-values.csv.export",
        "title": "CSV Viewer: Export…"
      },
      {
        "command": "get-unique-values.csv.chooseSheet",
        "title": "CSV Viewer: Choose Excel Sheet…"
      },
      {
        "command": "get-unique-values.sidebar.openFile",
        "title": "Data Toolkit: Open CSV or Excel File…"
      },
      {
        "command": "get-unique-values.sidebar.openRecent",
        "title": "Data Toolkit: Open Recent File"
      },
      {
        "command": "get-unique-values.sidebar.toggleFavorite",
        "title": "Data Toolkit: Toggle Favorite",
        "icon": "$(star-empty)"
      },
      {
        "command": "get-unique-values.sidebar.removeRecent",
        "title": "Data Toolkit: Remove from Recent",
        "icon": "$(close)"
      },
      {
        "command": "get-unique-values.sidebar.clearRecent",
        "title": "Data Toolkit: Clear Recent Files",
        "icon": "$(clear-all)"
      },
      {
        "command": "get-unique-values.sidebar.refresh",
        "title": "Data Toolkit: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "get-unique-values.sidebar.fileAction",
        "title": "Data Toolkit: Run Viewer Action"
      },
      {
        "command": "get-unique-values.sidebar.pickColumn",
        "title": "Data Toolkit: Pick a Column…"
      },
      {
        "command": "get-unique-values.sidebar.applySet",
        "title": "Data Toolkit: Apply Column Set"
      },
      {
        "command": "get-unique-values.sidebar.deleteSet",
        "title": "Data Toolkit: Delete Column Set",
        "icon": "$(trash)"
      },
      {
        "command": "get-unique-values.sidebar.saveSet",
        "title": "Data Toolkit: Save Current Columns as a Set…"
      },
      {
        "command": "get-unique-values.sidebar.applyPreset",
        "title": "Data Toolkit: Apply Parse Preset"
      },
      {
        "command": "get-unique-values.sidebar.deletePreset",
        "title": "Data Toolkit: Delete Parse Preset",
        "icon": "$(trash)"
      },
      {
        "command": "get-unique-values.sidebar.savePreset",
        "title": "Data Toolkit: Save Current Parse Settings as a Preset…"
      }
    ],
    "keybindings": [
      {
        "command": "get-unique-values.run",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "editorTextFocus"
      },
      {
        "command": "get-unique-values.csv.hideSelectedColumn",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h",
        "when": "activeCustomEditorId == 'getUniqueValues.csvViewer' || activeCustomEditorId == 'getUniqueValues.xlsxViewer'"
      },
      {
        "command": "get-unique-values.csv.showAllColumns",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u",
        "when": "activeCustomEditorId == 'getUniqueValues.csvViewer' || activeCustomEditorId == 'getUniqueValues.xlsxViewer'"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "get-unique-values.run",
          "group": "modification"
        }
      ],
      "editor/title": [
        {
          "command": "get-unique-values.openCsvViewer",
          "when": "resourceExtname =~ /^\\.(csv|tsv|psv|xlsx|xlsm)$/ && activeCustomEditorId != 'getUniqueValues.csvViewer' && activeCustomEditorId != 'getUniqueValues.xlsxViewer'",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "get-unique-values.openCsvViewer",
          "when": "resourceExtname =~ /^\\.(csv|tsv|psv|xlsx|xlsm)$/",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "get-unique-values.csv.hideSelectedColumn",
          "when": "false"
        },
        {
          "command": "get-unique-values.csv.showAllColumns",
          "when": "false"
        },
        {
          "command": "get-unique-values.csv.export",
          "when": "activeCustomEditorId == 'getUniqueValues.csvViewer' || activeCustomEditorId == 'getUniqueValues.xlsxViewer'"
        },
        {
          "command": "get-unique-values.csv.chooseSheet",
          "when": "activeCustomEditorId == 'getUniqueValues.xlsxViewer'"
        },
        {
          "command": "get-unique-values.openCsvViewer",
          "when": "resourceExtname =~ /^\\.(csv|tsv|psv|xlsx|xlsm)$/"
        },
        {
          "command": "get-unique-values.sidebar.openRecent",
          "when": "false"
        },
        {
          "command": "get-unique-values.sidebar.toggleFavorite",
          "when": "false"
        },
        {
          "command": "get-unique-values.sidebar.removeRecent",
          "when": "false"
        },
        {
          "command": "get-unique-values.sidebar.clearRecent",
          "when": "false"
        },
        {
          "command": "get-unique-values.sidebar.refresh",
          "when": "false"
        },
        {
          "command": "get-unique-values.sidebar.fileAction",
          "when": "false"
        },
        {
          "command": "get-unique-values.sidebar.pickColumn",
          "when": "false"
        },
        {
          "command": "get-unique-values.sidebar.applySet",
          "when": "false"
        },
        {
          "command": "get-unique-values.sidebar.deleteSet",
          "when": "false"
        },
        {
          "command": "get-unique-values.sidebar.saveSet",
          "when": "false"
        },
        {
          "command": "get-unique-values.sidebar.applyPreset",
          "when": "false"
        },
        {
          "command": "get-unique-values.sidebar.deletePreset",
          "when": "false"
        },
        {
          "command": "get-unique-values.sidebar.savePreset",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "get-unique-values.sidebar.toggleFavorite",
          "when": "view == dataToolkit.recent && viewItem == recentFile",
          "group": "inline"
        },
        {
          "command": "get-unique-values.sidebar.removeRecent",
          "when": "view == dataToolkit.recent && viewItem == recentFile",
          "group": "inline"
        },
        {
          "command": "get-unique-values.sidebar.deleteSet",
          "when": "view == dataToolkit.file && viewItem == columnSet",
          "group": "inline"
        },
        {
          "command": "get-unique-values.sidebar.deletePreset",
          "when": "view == dataToolkit.presets && viewItem == preset",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "get-unique-values.sidebar.clearRecent",
          "when": "view == dataToolkit.recent",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "getUniqueValues.csvViewer",
        "displayName": "CSV Viewer",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          },
          {
            "filenamePattern": "*.psv"
          }
        ]
      },
      {
        "viewType": "getUniqueValues.xlsxViewer",
        "displayName": "Excel Viewer",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xlsm"
          }
        ]
      }
    ],
    "configuration": {
      "title": "CSV Viewer",
      "properties": {
        "getUniqueValues.csv.largeFileMB": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "markdownDescription": "Offer to open CSV/TSV/PSV files larger than this many MB in the CSV Viewer. Set 0 to turn the prompt off."
        },
        "getUniqueValues.csv.defaultPageSize": {
          "type": "number",
          "enum": [
            50,
            100,
            250,
            500,
            1000
          ],
          "default": 100,
          "description": "Rows per page in the CSV Viewer."
        },
        "getUniqueValues.csv.columnColors": {
          "type": "string",
          "enum": [
            "header",
            "headerAndCells",
            "off"
          ],
          "default": "headerAndCells",
          "description": "Give every column its own colour: header only, header plus a tinted cell edge, or off."
        },
        "getUniqueValues.csv.longText": {
          "type": "string",
          "enum": [
            "truncate",
            "wrap",
            "full"
          ],
          "default": "truncate",
          "description": "How long cell values are shown: one truncated line, up to 3 wrapped lines, or in full."
        },
        "getUniqueValues.csv.defaultColumnWidth": {
          "type": "number",
          "default": 300,
          "minimum": 80,
          "description": "Default column width in pixels.",
          "maximum": 2000
        },
        "getUniqueValues.csv.presets": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "delimiter": {
                "type": "string"
              },
              "hasHeader": {
                "type": "boolean"
              },
              "encoding": {
                "type": "string",
                "enum": [
                  "utf-8",
                  "latin1"
                ]
              }
            },
            "required": [
              "name"
            ]
          },
          "markdownDescription": "Saved parse settings (delimiter, header, encoding). Manage them from the Data Toolkit sidebar."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dataToolkit",
          "title": "Data Toolkit",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "dataToolkit": [
        {
          "id": "dataToolkit.file",
          "name": "Current File"
        },
        {
          "id": "dataToolkit.tools",
          "name": "Tools"
        },
        {
          "id": "dataToolkit.recent",
          "name": "Recent & Favorites"
        },
        {
          "id": "dataToolkit.presets",
          "name": "Parse Presets"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dataToolkit.file",
        "contents": "No CSV or Excel file is open in the viewer.\n[Open a file](command:get-unique-values.sidebar.openFile)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "build": "node esbuild.mjs",
    "compile": "npm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p ./ --noEmit && tsc -p src/viewer --noEmit",
    "lint": "eslint src",
    "test:unit": "node -e \"require('fs').rmSync('out-test',{recursive:true,force:true})\" && node esbuild.mjs && tsc -p tsconfig.test.json && mocha --ui tdd \"out-test/test/unit/**/*.test.js\"",
    "test:integration": "node -e \"require('fs').rmSync('out-test',{recursive:true,force:true})\" && node esbuild.mjs && tsc -p tsconfig.test.json && vscode-test",
    "pretest": "npm run typecheck && npm run lint",
    "test": "npm run test:unit && npm run test:integration",
    "perf": "tsc -p tsconfig.test.json && node --expose-gc scripts/perf.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.25.1",
    "exceljs": "^4.4.0",
    "mocha": "^12.0.3",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/boopathirk/get-unique-values.git"
  },
  "bugs": {
    "url": "https://github.com/boopathirk/get-unique-values/issues"
  },
  "homepage": "https://github.com/boopathirk/get-unique-values"
}
